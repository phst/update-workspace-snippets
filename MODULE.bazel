module(name = "phst_update_workspace_snippets")

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# Require Go version explicitly until
# https://github.com/bazel-contrib/rules_go/issues/4696 is fixed.
go_sdk.from_file(go_mod = "//:go.mod")
go_sdk.nogo(nogo = "//dev:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "go.mod")
use_repo(
    go_deps,
    "co_honnef_go_tools",
    "com_github_bazelbuild_buildtools",
    "com_github_go_git_go_git_v5",
    "com_github_google_addlicense",
    "com_github_google_go_cmp",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4", dev_dependency = True, repo_name = "buildifier")
